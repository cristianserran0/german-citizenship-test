// The tutor's backend: one Cloudflare Worker, POST /api/ask, on Workers AI's
// free plan. The site itself stays on GitHub Pages; only this API runs here.
// Reused from the cristianserrano.ar guide (worker/index.js there).
//
//   npm run dev      local, no Cloudflare login, canned answers (MOCK_AI)
//   npm run deploy   publish (needs `npx wrangler login` once)
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "einbuergerungstest-tutor",
  "compatibility_date": "2026-07-11",
  "observability": { "enabled": true },
  "main": "index.js",
  // index.html is the one source of the questions; this writes
  // questions.json from it before every dev run and deploy.
  "build": { "command": "node extract-questions.mjs" },
  // Its own hostname on the cristianserrano.ar zone (Cloudflare creates the
  // DNS record and certificate on deploy). The site calls it cross-origin.
  "routes": [
    { "pattern": "germancitizenship-api.cristianserrano.ar", "custom_domain": true }
  ],
  "workers_dev": false,
  // Workers AI. Free plan: a daily allowance per Cloudflare ACCOUNT (shared
  // with the portfolio guide), refused -- never billed -- when it runs out.
  "ai": { "binding": "AI" },
  // Per-visitor limit: 5 questions a minute (the window can only be 10 or
  // 60 s). The daily AI allowance is the real ceiling.
  "ratelimits": [
    { "name": "LIMITER", "namespace_id": "2001", "simple": { "limit": 5, "period": 60 } }
  ],
  // Bindings aren't inherited by an environment, so `dev` has no AI and no
  // rate limit; MOCK_AI streams a canned answer in the real model's shape.
  "env": {
    "dev": { "vars": { "MOCK_AI": "1" } }
  }
}
